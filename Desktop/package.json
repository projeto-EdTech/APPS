{
  "name": "vestibuline",
  "version": "1.0.0",
  "description": "Vestibuline Desktop Application",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.vestibuline.app",
    "productName": "Vestibuline",
    "copyright": "Copyright © 2026 Vestibuline",
    "directories": {
      "output": "dist"
    },
    "icon": "build/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.education",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Education",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vestibuline",
      "language": "1046",
      "runAfterFinish": true
    },
    "files": [
      "src/**/*",
      "public/**/*",
      ".env",
      "node_modules/**/*",
      "package.json"
    ]
  },
  "keywords": [
    "vestibuline",
    "electron",
    "education"
  ],
  "author": "Vestibuline Team",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.3.9",
    "electron-window-state": "^5.0.3"
  }
}
